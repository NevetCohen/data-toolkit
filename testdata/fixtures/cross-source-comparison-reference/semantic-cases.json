      "right": "source_2.email"
    }
  ],
  "source_1": [
    { "row_id": "s1-alpha", "id": "100", "email": "alpha@example.test" },
    { "row_id": "s1-beta", "id": "200", "email": "beta@example.test" },
    { "row_id": "s1-both", "id": "300", "email": "both@example.test" },
    { "row_id": "s1-unmatched", "id": "400", "email": "left-only@example.test" }
